{
  "name": "devin-cli",
  "version": "0.1.0",
  "private": false,
  "description": "CLI for the Devin API v3 (self, billing/consumption, metrics)",
  "bin": {
    "devin-cli": "./src/cli.ts"
  },
  "type": "module",
  "scripts": {
    "start": "bun run src/cli.ts",
    "sync:openapi": "bun scripts/sync-openapi.ts",
    "generate": "orval --config orval.config.ts",
    "typecheck": "tsgo --noEmit",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun test"
  },
  "dependencies": {
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "@typescript/native-preview": "^7.0.0-dev.20260427.1",
    "lefthook": "^2.1.6",
    "orval": "^8.45.0",
    "oxfmt": "^0.47.0",
    "oxlint": "^1.62.0",
    "yaml": "^2.9.1"
  },
  "engines": {
    "bun": ">=1.4.3"
  }
}
